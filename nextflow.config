manifest {
    name = 'bacteria-hybrid-assembly'
    description = 'Reproducible bacterial hybrid assembly and polishing pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.0'
}

params {
    input = null
    outdir = 'results'
    genome_size = '5m'
    medaka_model = 'r1041_e82_400bps_hac_v4.3.0'
    long_read_mode = 'nano-hq'
    assemblers = 'flye,miniasm,raven'
    autocycler_subsamples = 4
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries = 1

    withLabel: process_low {
        cpus = 2
        memory = '4 GB'
        time = '2 h'
    }
    withLabel: process_medium {
        cpus = 4
        memory = '8 GB'
        time = '6 h'
    }
    withLabel: process_high {
        cpus = 8
        memory = '24 GB'
        time = '24 h'
    }

    withName: FASTP {
        ext.args = "--length_required 90"
        publishDir = [path: { "${params.outdir}/read_qc/${meta.id}/fastp" }, mode: 'copy', overwrite: true]
    }
    withName: FILTLONG {
        ext.args = '--min_length 1000 --keep_percent 90 --target_bases 500000000'
        ext.prefix = { "${meta.id}.long.filtered" }
        publishDir = [path: { "${params.outdir}/read_qc/${meta.id}/filtlong" }, mode: 'copy', overwrite: true]
    }
    withName: FASTQC {
        publishDir = [path: { "${params.outdir}/read_qc/${meta.id}/fastqc" }, mode: 'copy', overwrite: true]
    }
    withName: AUTOCYCLER_SUBSAMPLE {
        ext.args = { "--count ${params.autocycler_subsamples}" }
    }
    withName: FLYE {
        ext.args = { "--genome-size ${params.genome_size}" }
    }
    withName: MINIMAP2_ALIGN {
        ext.args = { params.long_read_mode == 'nano-hq' ? '-k19 -Xw7 -e0 -m100' : '-x ava-ont' }
    }
    withName: MINIMAP2_QC {
        ext.args = { params.long_read_mode == 'nano-hq' ? '-x lr:hq' : '-x map-ont' }
        publishDir = [path: { "${params.outdir}/assembly_qc/${meta.id}" }, mode: 'copy', overwrite: true]
    }
    withName: MINIPOLISH {
        ext.args = '--skip_initial'
        ext.min_depth_rel = 0.1
    }
    withName: CANU {
        cpus = 8
    }
    withName: AUTOCYCLER_COMPRESS {
        ext.args = '--max_contigs 100'
    }
    withName: AUTOCYCLER_COMBINE {
        publishDir = [path: { "${params.outdir}/assembly/${meta.id}" }, mode: 'copy', overwrite: true]
    }
    withName: DNAAPLER_ALL {
        ext.args = '--autocomplete mystery --seed_value 13'
    }
    withName: MEDAKA {
        ext.args = { "-m ${params.medaka_model} --bacteria" }
    }
    withName: BWA_MEM {
        ext.args = '-a'
        ext.args2 = '--output-fmt sam'
    }
    withName: POLYPOLISH_POLISH {
        ext.prefix = { "${meta.id}.polypolish" }
    }
    withName: SORT_FASTA {
        publishDir = [path: { "${params.outdir}/polish/${meta.id}" }, mode: 'copy', overwrite: true]
    }
    withName: ASSEMBLY_QC_STATS {
        publishDir = [path: { "${params.outdir}/assembly_qc/${meta.id}" }, mode: 'copy', overwrite: true]
    }
}

profiles {
    local {
        docker.enabled = true
        process.executor = 'local'
        params.assemblers = 'flye,miniasm,raven'
        process.resourceLimits = [cpus: 8, memory: '32 GB', time: '24 h']
    }

    slurm {
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.executor = 'slurm'
        process.queue = null
        params.assemblers = 'flye,miniasm,raven,metamdbg,canu,necat,nextdenovo'
        process {
            resourceLimits = [cpus: 32, memory: '128 GB', time: '72 h']
            withLabel: process_high {
                cpus = 32
                memory = '128 GB'
                time = '72 h'
            }
        }
    }

    test_stub {
        docker.enabled = true
        process.executor = 'local'
        process {
            resourceLimits = [cpus: 2, memory: '2 GB', time: '10 min']
            withLabel: process_low {
                cpus = 1
                memory = '1 GB'
                time = '10 min'
            }
            withLabel: process_medium {
                cpus = 1
                memory = '1 GB'
                time = '10 min'
            }
            withLabel: process_high {
                cpus = 2
                memory = '2 GB'
                time = '10 min'
            }
        }
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
